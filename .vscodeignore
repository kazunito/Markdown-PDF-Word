# ===== 配布物に含めないもの =====
.vscode/**
.gitignore
.git/**
src/**
verify/**
docs/**
samples/**
tsconfig.json
**/*.ts
!node_modules/**/*.d.ts
**/*.map
*.vsix

# ===== node_modules の圧縮 =====
# 型定義・ソースマップ・ドキュメント・テストは実行に不要
node_modules/**/*.md
node_modules/**/*.map
node_modules/**/*.ts
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/__tests__/**
node_modules/**/docs/**
node_modules/**/example/**
node_modules/**/examples/**
node_modules/**/.github/**
node_modules/**/LICENSE*
node_modules/**/CHANGELOG*
node_modules/.bin/**
node_modules/.package-lock.json

# 開発用ツールは同梱しない
node_modules/typescript/**
node_modules/@types/**

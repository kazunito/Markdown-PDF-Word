{
  "name": "markdown-formal-pdf",
  "displayName": "Markdown Formal PDF / Word",
  "description": "%description%",
  "version": "0.3.1",
  "publisher": "kazunito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazunito/Markdown-PDF-Word.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "markdown",
    "pdf",
    "word",
    "docx",
    "pagedjs"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownFormal.exportPdf",
        "title": "%command.markdownFormal.exportPdf.title%",
        "category": "Markdown Formal",
        "icon": "$(file-pdf)"
      },
      {
        "command": "markdownFormal.exportDocx",
        "title": "%command.markdownFormal.exportDocx.title%",
        "category": "Markdown Formal",
        "icon": "$(file-text)"
      },
      {
        "command": "markdownFormal.exportBoth",
        "title": "%command.markdownFormal.exportBoth.title%",
        "category": "Markdown Formal",
        "icon": "$(export)"
      },
      {
        "command": "markdownFormal.setOwnerPassword",
        "title": "%command.markdownFormal.setOwnerPassword.title%",
        "category": "Markdown Formal"
      },
      {
        "command": "markdownFormal.setCertPassphrase",
        "title": "%command.markdownFormal.setCertPassphrase.title%",
        "category": "Markdown Formal"
      },
      {
        "command": "markdownFormal.clearSecrets",
        "title": "%command.markdownFormal.clearSecrets.title%",
        "category": "Markdown Formal"
      },
      {
        "command": "markdownFormal.verifyPdf",
        "title": "%command.markdownFormal.verifyPdf.title%",
        "category": "Markdown Formal",
        "icon": "$(shield)"
      },
      {
        "command": "markdownFormal.openSettings",
        "title": "%command.markdownFormal.openSettings.title%",
        "category": "Markdown Formal",
        "icon": "$(gear)"
      }
    ],
    "submenus": [
      {
        "id": "markdownFormal.submenu",
        "label": "%submenu.markdownFormal.submenu.label%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == markdown",
          "submenu": "markdownFormal.submenu",
          "group": "navigation@100"
        }
      ],
      "editor/title/context": [
        {
          "when": "resourceLangId == markdown",
          "submenu": "markdownFormal.submenu",
          "group": "navigation@100"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == markdown",
          "submenu": "markdownFormal.submenu",
          "group": "navigation@100"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId == markdown",
          "command": "markdownFormal.exportBoth",
          "group": "navigation@100"
        }
      ],
      "markdownFormal.submenu": [
        {
          "command": "markdownFormal.exportPdf",
          "group": "1_export@1"
        },
        {
          "command": "markdownFormal.exportDocx",
          "group": "1_export@2"
        },
        {
          "command": "markdownFormal.exportBoth",
          "group": "1_export@3"
        },
        {
          "command": "markdownFormal.verifyPdf",
          "group": "2_verify@1"
        },
        {
          "command": "markdownFormal.openSettings",
          "group": "3_config@1"
        }
      ],
      "commandPalette": [
        {
          "command": "markdownFormal.exportPdf",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownFormal.exportDocx",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownFormal.exportBoth",
          "when": "editorLangId == markdown"
        }
      ]
    },
    "configuration": [
      {
        "id": "markdownFormal.page",
        "title": "%configuration.markdownFormal.page.title%",
        "order": 1,
        "properties": {
          "markdownFormal.page.format": {
            "type": "string",
            "default": "A4",
            "enum": [
              "A4",
              "A3",
              "B5",
              "Letter",
              "Legal"
            ],
            "description": "%markdownFormal.page.format.description%",
            "enumDescriptions": [
              "%markdownFormal.page.format.enum.A4%",
              "%markdownFormal.page.format.enum.A3%",
              "%markdownFormal.page.format.enum.B5%",
              "%markdownFormal.page.format.enum.Letter%",
              "%markdownFormal.page.format.enum.Legal%"
            ],
            "order": 1
          },
          "markdownFormal.page.orientation": {
            "type": "string",
            "default": "portrait",
            "enum": [
              "portrait",
              "landscape"
            ],
            "enumDescriptions": [
              "%markdownFormal.page.orientation.enum.portrait%",
              "%markdownFormal.page.orientation.enum.landscape%"
            ],
            "description": "%markdownFormal.page.orientation.description%",
            "order": 2
          },
          "markdownFormal.page.margin": {
            "type": "string",
            "default": "18mm",
            "description": "%markdownFormal.page.margin.description%",
            "order": 3
          },
          "markdownFormal.frame.body": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.frame.body.description%",
            "order": 4
          },
          "markdownFormal.frame.toc": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.frame.toc.description%",
            "order": 5
          },
          "markdownFormal.frame.cover": {
            "type": "boolean",
            "default": false,
            "description": "%markdownFormal.frame.cover.description%",
            "order": 6
          },
          "markdownFormal.frame.color": {
            "type": "string",
            "default": "#444444",
            "description": "%markdownFormal.frame.color.description%",
            "order": 7
          },
          "markdownFormal.frame.width": {
            "type": "string",
            "default": "0.6mm",
            "description": "%markdownFormal.frame.width.description%",
            "order": 8
          },
          "markdownFormal.frame.padding": {
            "type": "string",
            "default": "5mm",
            "description": "%markdownFormal.frame.padding.description%",
            "order": 9
          }
        }
      },
      {
        "id": "markdownFormal.style",
        "title": "%configuration.markdownFormal.style.title%",
        "order": 2,
        "properties": {
          "markdownFormal.font.body": {
            "type": "string",
            "default": "\"Hiragino Mincho ProN\", \"Yu Mincho\", \"YuMincho\", \"Noto Serif CJK JP\", \"Noto Serif JP\", serif",
            "description": "%markdownFormal.font.body.description%",
            "order": 1
          },
          "markdownFormal.font.heading": {
            "type": "string",
            "default": "\"Hiragino Sans\", \"Yu Gothic\", \"Meiryo\", \"Noto Sans CJK JP\", \"Noto Sans JP\", sans-serif",
            "description": "%markdownFormal.font.heading.description%",
            "order": 2
          },
          "markdownFormal.font.mono": {
            "type": "string",
            "default": "\"Menlo\", \"Consolas\", \"DejaVu Sans Mono\", monospace",
            "description": "%markdownFormal.font.mono.description%",
            "order": 3
          },
          "markdownFormal.font.size": {
            "type": "string",
            "default": "10.5pt",
            "description": "%markdownFormal.font.size.description%",
            "order": 4
          },
          "markdownFormal.font.lineHeight": {
            "type": "number",
            "default": 1.75,
            "description": "%markdownFormal.font.lineHeight.description%",
            "order": 5
          },
          "markdownFormal.heading.style": {
            "type": "string",
            "default": "band",
            "enum": [
              "plain",
              "band",
              "underline"
            ],
            "enumDescriptions": [
              "%markdownFormal.heading.style.enum.plain%",
              "%markdownFormal.heading.style.enum.band%",
              "%markdownFormal.heading.style.enum.underline%"
            ],
            "description": "%markdownFormal.heading.style.description%",
            "order": 6
          },
          "markdownFormal.heading.accentColor": {
            "type": "string",
            "default": "#4472C4",
            "description": "%markdownFormal.heading.accentColor.description%",
            "order": 7
          },
          "markdownFormal.heading.textColor": {
            "type": "string",
            "default": "#2E74B5",
            "description": "%markdownFormal.heading.textColor.description%",
            "order": 8
          },
          "markdownFormal.heading.pageBreakLevel": {
            "type": "number",
            "default": 2,
            "minimum": 0,
            "maximum": 3,
            "description": "%markdownFormal.heading.pageBreakLevel.description%",
            "order": 9
          }
        }
      },
      {
        "id": "markdownFormal.document",
        "title": "%configuration.markdownFormal.document.title%",
        "order": 3,
        "properties": {
          "markdownFormal.cover.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.cover.enabled.description%",
            "order": 1
          },
          "markdownFormal.stamp.color": {
            "type": "string",
            "default": "#CC0000",
            "description": "%markdownFormal.stamp.color.description%",
            "order": 2
          },
          "markdownFormal.stamp.rotate": {
            "type": "number",
            "default": -8,
            "description": "%markdownFormal.stamp.rotate.description%",
            "order": 3
          },
          "markdownFormal.toc.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.toc.enabled.description%",
            "order": 4
          },
          "markdownFormal.toc.depth": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 6,
            "description": "%markdownFormal.toc.depth.description%",
            "order": 5
          },
          "markdownFormal.toc.title": {
            "type": "string",
            "default": "Contents",
            "description": "%markdownFormal.toc.title.description%",
            "order": 6
          },
          "markdownFormal.pageNumber.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.pageNumber.enabled.description%",
            "order": 7
          },
          "markdownFormal.pageNumber.position": {
            "type": "string",
            "default": "bottom-center",
            "enum": [
              "bottom-center",
              "bottom-right",
              "bottom-left",
              "top-center",
              "top-right"
            ],
            "description": "%markdownFormal.pageNumber.position.description%",
            "enumDescriptions": [
              "%markdownFormal.pageNumber.position.enum.bottom-center%",
              "%markdownFormal.pageNumber.position.enum.bottom-right%",
              "%markdownFormal.pageNumber.position.enum.bottom-left%",
              "%markdownFormal.pageNumber.position.enum.top-center%",
              "%markdownFormal.pageNumber.position.enum.top-right%"
            ],
            "order": 8
          },
          "markdownFormal.outline.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.outline.enabled.description%",
            "order": 9
          },
          "markdownFormal.mermaid.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.mermaid.enabled.description%",
            "order": 10
          },
          "markdownFormal.mermaid.theme": {
            "type": "string",
            "default": "neutral",
            "enum": [
              "default",
              "neutral",
              "forest",
              "dark"
            ],
            "enumDescriptions": [
              "%markdownFormal.mermaid.theme.enum.default%",
              "%markdownFormal.mermaid.theme.enum.neutral%",
              "%markdownFormal.mermaid.theme.enum.forest%",
              "%markdownFormal.mermaid.theme.enum.dark%"
            ],
            "description": "%markdownFormal.mermaid.theme.description%",
            "order": 11
          },
          "markdownFormal.mermaid.maxWidth": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 100,
            "description": "%markdownFormal.mermaid.maxWidth.description%",
            "order": 12
          }
        }
      },
      {
        "id": "markdownFormal.protection",
        "title": "%configuration.markdownFormal.protection.title%",
        "order": 4,
        "properties": {
          "markdownFormal.protection.mode": {
            "type": "string",
            "default": "restrict",
            "enum": [
              "none",
              "restrict",
              "sign"
            ],
            "enumDescriptions": [
              "%markdownFormal.protection.mode.enum.none%",
              "%markdownFormal.protection.mode.enum.restrict%",
              "%markdownFormal.protection.mode.enum.sign%"
            ],
            "description": "%markdownFormal.protection.mode.description%",
            "order": 1
          },
          "markdownFormal.protection.permissions.printing": {
            "type": "string",
            "default": "highResolution",
            "enum": [
              "none",
              "lowResolution",
              "highResolution"
            ],
            "description": "%markdownFormal.protection.permissions.printing.description%",
            "enumDescriptions": [
              "%markdownFormal.protection.permissions.printing.enum.none%",
              "%markdownFormal.protection.permissions.printing.enum.lowResolution%",
              "%markdownFormal.protection.permissions.printing.enum.highResolution%"
            ],
            "order": 2
          },
          "markdownFormal.protection.permissions.copying": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.protection.permissions.copying.description%",
            "order": 3
          },
          "markdownFormal.protection.permissions.annotating": {
            "type": "boolean",
            "default": false,
            "description": "%markdownFormal.protection.permissions.annotating.description%",
            "order": 4
          },
          "markdownFormal.signing.certificatePath": {
            "type": "string",
            "default": "",
            "description": "%markdownFormal.signing.certificatePath.description%",
            "order": 5
          },
          "markdownFormal.signing.reason": {
            "type": "string",
            "default": "Approved as an official document",
            "description": "%markdownFormal.signing.reason.description%",
            "order": 6
          },
          "markdownFormal.signing.location": {
            "type": "string",
            "default": "",
            "description": "%markdownFormal.signing.location.description%",
            "order": 7
          },
          "markdownFormal.signing.contactInfo": {
            "type": "string",
            "default": "",
            "description": "%markdownFormal.signing.contactInfo.description%",
            "order": 8
          },
          "markdownFormal.hash.emit": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.hash.emit.description%",
            "order": 9
          }
        }
      },
      {
        "id": "markdownFormal.output",
        "title": "%configuration.markdownFormal.output.title%",
        "order": 5,
        "properties": {
          "markdownFormal.outputDirectory": {
            "type": "string",
            "default": "",
            "description": "%markdownFormal.outputDirectory.description%",
            "order": 1
          },
          "markdownFormal.docx.enabled": {
            "type": "boolean",
            "default": true,
            "description": "%markdownFormal.docx.enabled.description%",
            "order": 2
          },
          "markdownFormal.browser.executablePath": {
            "type": "string",
            "default": "",
            "description": "%markdownFormal.browser.executablePath.description%",
            "order": 3
          },
          "markdownFormal.customCss": {
            "type": "string",
            "default": "",
            "description": "%markdownFormal.customCss.description%",
            "order": 4
          }
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./ && node scripts/copy-mermaid.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.8.1",
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "docx": "^9.7.1",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "markdown-it": "^14.1.0",
    "pagedjs-cli": "^0.4.3",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^20.9.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "mermaid": "^11.17.2",
    "typescript": "^5.5.0"
  },
  "l10n": "./l10n"
}
